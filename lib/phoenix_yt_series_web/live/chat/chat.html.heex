<div
  id="sidebar"
  class="fixed left-0 top-0 h-screen w-64 transform -translate-x-full transition-transform duration-300 ease-in-out bg-white dark:bg-gray-800 shadow-lg"
  phx-hook="Sidebar"
>
  <div class="p-4">
    <button
      class="absolute right-4 top-4 text-gray-500 hover:text-gray-700"
      phx-click="toggle_sidebar"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"
        />
      </svg>
    </button>
  </div>
</div>
<nav class="mt-8">
  <ul class="space-y-4">
    <li>
      <a
        href="#"
        class="block text-gray-700 hover:text-gray-900 dark:text-gray-300 dark:hover:text-white"
      >
        Dashboard
      </a>
    </li>
    <li>
      <a
        href="#"
        class="block text-gray-700 hover:text-gray-900 dark:text-gray-300 dark:hover:text-white"
      >
        Profile
      </a>
    </li>
    <li>
      <a
        href="#"
        class="block text-gray-700 hover:text-gray-900 dark:text-gray-300 dark:hover:text-white"
      >
        Settings
      </a>
    </li>
  </ul>
</nav>

<button class="fixed left-4 top-4 text-gray-500 hover:text-gray-700" phx-click="toggle_sidebar">
  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M4 6h16M4 12h16M4 18h16"
    />
  </svg>
</button>
<!-- box layout -->
<div class="container py-16">
  <div class="px-4 py-8 sm:px-0">
    <div class="flex flex-col items-center justify-center
      border-4 border-gray-300 border-dashed rounded-lg dark:border-gray-800 h-auto p-8 space-y-6">
      <!-- Existing Content -->

      <div class="text-xl text-center">
        <div class="mb-4">Build your masterpiece 🚀</div>
        
<!-- Counter Display -->

        <div id="counter" class="text-4xl font-bold mb-4 text-gray-800 ">
          {@counter}
        </div>
        
<!-- Increment Button -->

        <Button.button phx-click="increment" variant="destructive">
          Increment Counter
        </Button.button>
      </div>
    </div>
  </div>
</div>
<%!-- </.layout> --%>
